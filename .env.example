# 复制本文件为 .env，填入真实值（.env 已被 gitignore，不会入库）
# ===== 必填（D4 问答功能需要）=====
SILICONFLOW_API_KEY=sk-你的硅基流动key

# ===== 可选：换模型 / 换平台 =====
# 示例1（硅基流动，默认）：逐行去掉注释即可
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# CHAT_BASE_URL=https://api.siliconflow.cn/v1
# CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# 示例2（阿里百炼 DashScope）：
# EMBEDDING_API_KEY=sk-阿里key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# CHAT_API_KEY=sk-阿里key
# CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CHAT_MODEL=qwen-plus
JWT_SECRET=请改成随机长字符串
JWT_TTL_HOURS=72
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOPK=5
# ===== 可选：检索精排（rerank，缺省复用 SILICONFLOW_API_KEY）=====
# RERANK_API_KEY=
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
MAX_UPLOAD_MB=20
SQLITE_PATH=./data/jianshen.db
