# 复制本文件为 .env，填入真实值（.env 已被 gitignore，不会入库）
# ===== 必填（D4 问答功能需要）=====
SILICONFLOW_API_KEY=sk-你的硅基流动key

# ===== 可选覆盖 =====
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
CHAT_MODEL=deepseek-ai/DeepSeek-V3
JWT_SECRET=请改成随机长字符串
JWT_TTL_HOURS=72
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOPK=5
MAX_UPLOAD_MB=20
SQLITE_PATH=./data/jianshen.db
